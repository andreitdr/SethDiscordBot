<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Tests.DiscordBotCore.PluginManagement" />
      <InternalsVisibleTo Include="Tests.DiscordBotCore.PluginManagement.Loading" />
      <InternalsVisibleTo Include="Tests.WebUI" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
      <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
      <!-- NuGet.Packaging brings in 8.0.1, which has known vulnerabilities -->
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DiscordBotCore.Configuration\DiscordBotCore.Configuration.csproj" />
      <ProjectReference Include="..\DiscordBotCore.Database.Sqlite\DiscordBotCore.Database.Sqlite.csproj" />
      <ProjectReference Include="..\DiscordBotCore.Logging\DiscordBotCore.Logging.csproj" />
      <ProjectReference Include="..\DiscordBotCore.Networking\DiscordBotCore.Networking.csproj" />
      <ProjectReference Include="..\DiscordBotCore.Resources\DiscordBotCore.Resources.csproj" />
      <ProjectReference Include="..\DiscordBotCore.Utilities\DiscordBotCore.Utilities.csproj" />
    </ItemGroup>

</Project>
